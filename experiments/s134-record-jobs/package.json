{
  "name": "@samedaydesk/s134-record-jobs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bounded offline record-job CLIs: OpenAPI used-op impact, pricing-table field/unit change, CSV drift with uncertainty, RSS/Atom correction+dedup brief. No paid fetch/LLM.",
  "bin": {
    "s134-openapi-impact": "./modules/openapi-impact/cli.mjs",
    "s134-pricing-table-change": "./modules/pricing-table-change/cli.mjs",
    "s134-csv-drift": "./modules/csv-drift/cli.mjs",
    "s134-rss-atom-brief": "./modules/rss-atom-brief/cli.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo:openapi": "node modules/openapi-impact/cli.mjs --before fixtures/openapi/positive/before.json --after fixtures/openapi/positive/after.json --used fixtures/openapi/positive/used.json",
    "demo:pricing": "node modules/pricing-table-change/cli.mjs --before fixtures/pricing/positive/before.json --after fixtures/pricing/positive/after.json",
    "demo:csv": "node modules/csv-drift/cli.mjs --before fixtures/csv/positive/before.csv --after fixtures/csv/positive/after.csv --key sku",
    "demo:rss": "node modules/rss-atom-brief/cli.mjs --before fixtures/rss/positive/before.xml --after fixtures/rss/positive/after.xml",
    "demo:all": "npm run -s demo:openapi && npm run -s demo:pricing && npm run -s demo:csv && npm run -s demo:rss"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "fast-xml-parser": "^5.11.1",
    "yaml": "^2.9.0"
  }
}