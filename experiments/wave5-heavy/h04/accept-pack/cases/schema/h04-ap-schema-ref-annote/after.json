{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accept-pack.local/h04/berth-code-ref.schema.json",
  "title": "Berth code via $ref",
  "$defs": {
    "BerthCode": {
      "type": "string",
      "minLength": 3,
      "maxLength": 12
    }
  },
  "type": "object",
  "required": ["berthCode"],
  "properties": {
    "berthCode": {
      "$ref": "#/$defs/BerthCode",
      "description": "ISO-style wharf berth identifier (docs only).",
      "title": "Berth code"
    },
    "radioChannel": {
      "type": "string",
      "description": "VHF channel (reworded; unused)."
    }
  }
}
