# SameDayDesk environment. Names only. Real values live in the host's environment panel,
# never in this repository. Every integration below degrades gracefully when unset:
# the site boots, the pages serve, and the features that need a key say so out loud.

NODE_ENV=development
PORT=3000
PUBLIC_URL=https://samedaydesk.com

# Supabase: order and intake storage, the free report cache and quota, dashboard auth.
# Without these the site still sells: paid orders and intakes are emailed to ADMIN_EMAIL
# instead of stored, and the answer panel stays closed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_BUCKET=

# Stripe: hosted Checkout Sessions created server side from an offer slug.
# Without these the pay cards explain that payment is not switched on.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend: payment confirmation, intake confirmation, the one-shot intake reminder,
# and the sprint access checklist. Without these nothing is sent and nothing breaks.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=
ADMIN_EMAIL=
ADMIN_UID=

# Answer panel for the free report. All three are required together: with any of them
# missing the report runs the readability checks only and the button copy changes to match.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Daily ceiling for live answer checks, in cents. Default 500 when unset.
REPORT_DAILY_BUDGET_CENTS=500

# Metrics endpoint. Without it /api/metrics does not exist at all.
ADMIN_METRICS_TOKEN=

# Homepage measurement sidecar. Without this token /api/home-measure does not exist.
# The file holds daily UTC integer aggregates only: no IP, user agent, cookie, or identity.
HOMEPAGE_MEASURE_TOKEN=
HOMEPAGE_MEASURE_FILE=

# Server-side events. Without a key events are logged rather than sent.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
