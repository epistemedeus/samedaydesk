# deps
node_modules/

# Exact pin checkouts acquired by tools/l08-agent-repair. Not sibling names.
tools/l08-agent-repair/.pin-cache/
client/node_modules/

# build output (root/client only; vendored correspondence dist is committed)
client/dist/
/dist/
vendor/**/node_modules/
vendor/visitor-foundry-receiver/scripts/visitor-foundry/execution/.runtime/
vendor/visitor-foundry-receiver/scripts/visitor-foundry/execution/.python-standalone/
vendor/visitor-foundry-receiver/scripts/visitor-foundry/execution/.build/

# env / secrets — NEVER commit
.env
.env.*
!.env.example
*.key
service-account*.json
secrets/

# logs
*.log
npm-debug.log*

# editor / OS
.DS_Store
.vscode/
.idea/

# test/coverage
coverage/
playwright-report/
test-results/

# supabase local
supabase/.temp/
supabase/.branches/

# Full CDP Bazaar discovery snapshots stay local. Git tracks only the compact
# per-route observation record and changelog under data/bazaar-tracker/.
data/bazaar-tracker/snapshots/

# Recurring recipe runtime outputs stay local; fixtures remain tracked.
tools/recurring-job-recipes/artifacts/**
!tools/recurring-job-recipes/artifacts/.gitkeep

# Verified-feed refresh candidates stay local until review.
client/tmp/
