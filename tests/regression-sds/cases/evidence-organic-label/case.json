{
  "schemaVersion": 1,
  "id": "evidence-organic-label",
  "repo": "samedaydesk",
  "surface": "verifier",
  "feature": "evidence-records",
  "class": "regression",
  "defect": "Operator-controlled or incentivized traffic labeled organic must be rejected (organic_label_for_controlled_or_incentivized_traffic).",
  "source": {
    "kind": "product-test",
    "ref": "tools/evidence-records/fixtures/invalid/organic-label-for-controlled-traffic.json"
  },
  "execute": {
    "kind": "spawn",
    "timeoutMs": 10000,
    "argv": [
      "{{node}}",
      "tools/evidence-records/validate.mjs",
      "--expect-reject",
      "organic_label_for_controlled_or_incentivized_traffic",
      "{{root}}/tools/evidence-records/fixtures/invalid/organic-label-for-controlled-traffic.json"
    ]
  },
  "expectProduct": {
    "exitCode": 0,
    "stdoutJson": {
      "ok": true,
      "expectReject": "organic_label_for_controlled_or_incentivized_traffic",
      "codes": ["organic_label_for_controlled_or_incentivized_traffic"]
    }
  },
  "expectCorpus": {
    "productVerdict": "accept",
    "naiveRule": "exit0"
  },
  "boundary": {
    "paymentSent": false,
    "toolsCalled": false
  }
}
