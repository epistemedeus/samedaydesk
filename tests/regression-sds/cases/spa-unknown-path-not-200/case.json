{
  "schemaVersion": 1,
  "id": "spa-unknown-path-not-200",
  "repo": "samedaydesk",
  "surface": "merchant",
  "feature": "hosted-readback",
  "class": "regression",
  "defect": "Unknown HTML paths used to return HTTP 200 SPA index (crawler soft-404, GitHub issue #1). createSpaFallback must 404 /this-path-does-not-exist-xyz.",
  "source": {
    "kind": "github-issue",
    "ref": "https://github.com/epistemedeus/samedaydesk/issues/1"
  },
  "execute": {
    "kind": "spa-unknown",
    "path": "/this-path-does-not-exist-xyz"
  },
  "expectProduct": {
    "exitCode": 0,
    "httpStatus": 404,
    "stdoutJson": {
      "ok": false,
      "status": 404
    }
  },
  "expectCorpus": {
    "productVerdict": "reject",
    "naiveRule": "http-200"
  },
  "boundary": {
    "paymentSent": false,
    "toolsCalled": false
  }
}
