{
  "schemaVersion": 1,
  "id": "result-reuse-missing-out",
  "repo": "samedaydesk",
  "surface": "buyer",
  "feature": "result-reuse",
  "class": "regression",
  "defect": "result-reuse export without --out must refuse. Writing reuse evidence is opt-in and never implied by a successful preview.",
  "source": {
    "kind": "product-test",
    "ref": "tools/result-reuse/cli.mjs"
  },
  "execute": {
    "kind": "spawn",
    "timeoutMs": 10000,
    "argv": [
      "{{node}}",
      "tools/result-reuse/cli.mjs",
      "export",
      "--input",
      "{{root}}/tools/result-reuse/fixtures/accepted-page-change.json",
      "--task-id",
      "corpus-reuse",
      "--subject",
      "corpus-reuse-result",
      "--sequence",
      "1",
      "--clock",
      "2026-09-09T10:00:00.000Z",
      "--opt-in"
    ]
  },
  "expectProduct": {
    "exitCode": 1,
    "stdoutJson": {
      "ok": false,
      "message": "export requires --out"
    }
  },
  "expectCorpus": {
    "productVerdict": "reject",
    "naiveRule": "exit0"
  },
  "boundary": {
    "paymentSent": false,
    "toolsCalled": false
  }
}
