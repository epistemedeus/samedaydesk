  "bin": {
    "failed-delivery-dossier": "./bin/dossier.mjs"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "pack": "node ./bin/dossier.mjs pack --wrapper-receipt fixtures/wrapper-receipt/rejected-sample-not-a-sale.json --checkout-intake fixtures/checkout-intake/fulfillment-pending-verify.json --extract-unpaid fixtures/extract-unpaid/agent402-stop.json"
  },
