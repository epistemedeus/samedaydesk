{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samedaydesk.com/schema/sha-bind-unpaid.w8.v1.json",
  "title": "SameDayDesk w8 SHA-bind unpaid evidence",
  "description": "One unpaid SDS observation bound to the SHA-256 of a committed artifact. Shape only; bind and unpaid policy are enforced by the validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bindId",
    "wave",
    "statusClass",
    "kind",
    "paymentSent",
    "charged",
    "artifact",
    "claims",
    "observationWindow",
    "completeness",
    "authorityClass",
    "unknownWhenAbsent",
    "prohibitedInferences"
  ],
  "properties": {
    "schemaVersion": {
      "const": "samedaydesk.evidence-record.sha-bind-unpaid.w8.v1"
    },
    "bindId": {
      "type": "string",
      "pattern": "^sbu_w8_[a-z0-9_]{2,80}$"
    },
    "wave": { "const": "w8" },
    "statusClass": { "const": "unpaid" },
    "kind": {
      "type": "string",
      "enum": [
        "unpaid_payment_required",
        "unpaid_offer",
        "unpaid_buyer_stop",
        "unpaid_discover",
        "unpaid_catalog",
        "unpaid_traffic_record",
        "unpaid_mcp_inventory"
      ]
    },
    "paymentSent": { "const": false },
    "charged": { "const": false },
    "httpStatus": { "const": 402 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9./_-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "claims": {
      "type": "object",
      "minProperties": 1
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": { "type": "string", "enum": ["GET", "POST"] },
        "url": { "type": "string", "maxLength": 500 },
        "headers": { "type": "object" }
      }
    },
    "settlement": {
      "description": "Forbidden on unpaid binds. Present only on seeded paid-as-unpaid rejects.",
      "type": ["object", "null"]
    },
    "observationWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "reportingDelaySeconds"],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "end": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "reportingDelaySeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        }
      }
    },
    "completeness": {
      "type": "string",
      "enum": ["complete", "sampled", "truncated", "unknown"]
    },
    "authorityClass": {
      "type": "string",
      "enum": [
        "seller_observed",
        "provider_returned",
        "independently_reconciled",
        "provider_authoritative"
      ]
    },
    "unknownWhenAbsent": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "prohibitedInferences": {
      "type": "array",
      "minItems": 5,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "paid_as_unpaid",
          "sha_mismatch_is_bound",
          "unbound_bytes_are_evidence",
          "settlement_is_unpaid",
          "http_402_is_delivery",
          "catalog_presence_is_demand",
          "payment_header_is_unpaid",
          "tools_list_is_paid_call"
        ]
      }
    }
  }
}
