{
  "name": "@samedaydesk/pre-spend-cost-assurance",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "W0-R14-04 / SDS PR57 pre-spend cost assurance. Lists tools, accounts, and a decimal-string cap without authorizing purchase. No settle/prepare, no live SDS price change.",
  "bin": {
    "pre-spend": "./bin/pre-spend.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "list": "node ./bin/pre-spend.mjs list",
    "journey": "node ./bin/pre-spend.mjs journey --fixture fixtures/ok.json",
    "assure": "node ./bin/pre-spend.mjs assure --plan fixtures/ok-plan.json",
    "seeded-failure": "node ./bin/pre-spend.mjs --seeded-failure default-purchase"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
