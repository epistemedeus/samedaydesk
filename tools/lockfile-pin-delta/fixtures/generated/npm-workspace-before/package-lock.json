{
  "name": "workspace-probe",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "workspace-probe",
      "version": "1.0.0",
      "workspaces": [
        "packages/*"
      ],
      "dependencies": {
        "local-pkg": "*"
      }
    },
    "node_modules/local-pkg": {
      "resolved": "packages/local-pkg",
      "link": true
    },
    "packages/local-pkg": {
      "version": "1.0.0"
    }
  }
}
