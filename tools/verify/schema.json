{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samedaydesk.com/verify/envelope.schema.json",
  "title": "samedaydesk verify JSON envelope",
  "description": "Single stdout object for tools/verify/cli.mjs. Human text belongs on stderr. Copied per product repo; not a Pilot package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "schemaVersion",
    "command",
    "repo",
    "checkedAt",
    "node",
    "dryRun",
    "status",
    "feature",
    "evidence",
    "error",
    "boundary"
  ],
  "properties": {
    "ok": { "type": "boolean" },
    "schemaVersion": { "const": 1 },
    "command": { "type": "string", "minLength": 1 },
    "repo": { "const": "samedaydesk" },
    "checkedAt": { "type": "string", "format": "date-time" },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wanted", "actual"],
      "properties": {
        "wanted": { "type": "string" },
        "actual": { "type": "string" },
        "major": { "type": "integer" }
      }
    },
    "dryRun": { "type": "boolean" },
    "status": { "enum": ["pass", "fail", "usage", "error"] },
    "feature": { "type": ["string", "null"] },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "error": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string" },
            "detail": true
          }
        }
      ]
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paymentSent", "toolsCalled"],
      "properties": {
        "paymentSent": { "type": "boolean" },
        "toolsCalled": { "type": "boolean" }
      }
    },
    "result": true
  }
}
