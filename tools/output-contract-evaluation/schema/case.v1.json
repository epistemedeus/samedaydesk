{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "samedaydesk.output-contract-evaluation.case.v1",
  "title": "Output-contract evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "caseId", "promisedContract", "output", "settlement"],
  "properties": {
    "schema": { "const": "samedaydesk.output-contract-evaluation.case.v1" },
    "caseId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,95}$" },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "priceUsdc": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,15})(?:\\.[0-9]{1,8})?$" },
        "live": { "type": "boolean" },
        "skuPublished": { "type": "boolean" },
        "payment": { "const": "none" },
        "charged": { "type": "boolean" },
        "charge": { "type": "boolean" }
      }
    },
    "promisedContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredPaths"],
      "properties": {
        "method": { "enum": ["GET", "POST"] },
        "route": { "type": "string", "minLength": 1, "maxLength": 200 },
        "mimeType": { "type": "string" },
        "requiredPaths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["httpStatus", "body"],
      "properties": {
        "httpStatus": { "type": "integer", "minimum": 100, "maximum": 599 },
        "body": { "type": ["object", "array"] },
        "decision": { "type": "string" }
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "amountUsdc", "buyerClass", "validDeliveryStatus"],
      "properties": {
        "operationId": { "type": "string" },
        "amountUsdc": { "type": "string" },
        "buyerClass": { "enum": ["independent", "owner", "sponsored", "unknown"] },
        "validDeliveryStatus": { "type": "string" },
        "transaction": { "type": "string" },
        "facilitatorOrPayoutRef": { "type": "string" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onInvalid": { "enum": ["preserve_settlement", "preserve", "keep"] }
      }
    }
  }
}
