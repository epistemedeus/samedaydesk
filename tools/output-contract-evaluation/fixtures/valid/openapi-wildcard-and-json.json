{
  "openapi": "3.1.0",
  "info": {
    "title": "JSON preferred over wildcard content",
    "version": "0.0.1"
  },
  "paths": {
    "/extract": {
      "get": {
        "operationId": "extractUrl",
        "x-payment-info": {
          "price": { "amount": "0.005", "currency": "USD", "mode": "fixed" }
        },
        "responses": {
          "200": {
            "description": "Structured extract",
            "content": {
              "*/*": {
                "schema": { "type": "string" }
              },
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["ok", "title", "url"],
                  "properties": {
                    "ok": { "type": "boolean" },
                    "title": { "type": "string" },
                    "url": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
