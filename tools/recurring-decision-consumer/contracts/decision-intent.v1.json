{
  "$id": "samedaydesk.recurring-decision-intent.v1",
  "title": "Caller decision intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "intentId", "subject", "fields", "compare"],
  "properties": {
    "schema": { "const": "samedaydesk.recurring-decision-intent.v1" },
    "intentId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "subject": { "type": "string", "minLength": 1, "maxLength": 256 },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "compare": {
      "type": "string",
      "enum": ["field_equality", "payload_digest"]
    },
    "supportedCaptureSchemas": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
