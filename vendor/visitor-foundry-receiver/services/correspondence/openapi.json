{
  "openapi": "3.1.0",
  "info": {
    "title": "Neomorphic Project Correspondence API",
    "version": "1.0.0",
    "description": "Bounded project correspondence transport for closed-pilot Neomorphic trials. The service stores requests, replies, and artifact references. It does not execute instructions, authorize purchases, issue business credentials, fetch arbitrary URLs, send email, or run callbacks."
  },
  "servers": [
    {
      "url": "https://correspondence.example.invalid",
      "description": "Standalone root deployment. CLI --base-url is this origin with no extra path. Paths below are rooted at /healthz and /v1."
    },
    {
      "url": "https://correspondence.example.invalid/api/correspondence",
      "description": "Optional shared-host mount prefix. CLI --base-url, saved trial state, OpenAPI calls, and client baseUrl must include /api/correspondence. An origin or path change must not silently rebind a saved token. Paths below remain /healthz and /v1 relative to this prefix."
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "Administrator token for bootstrap, or a project grant token. Tokens never appear in URLs. Only hashes are stored."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      },
      "NextAction": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "enum": ["reply", "human_review"] },
              "url": { "type": "string", "maxLength": 2048 }
            }
          }
        ]
      },
      "Project": {
        "type": "object",
        "required": ["id", "title", "summary", "status", "version", "nextAction", "createdAt", "updatedAt"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "maxLength": 120 },
          "summary": { "type": "string", "maxLength": 2000 },
          "status": { "type": "string", "enum": ["open", "needs_human", "resolved"] },
          "version": { "type": "integer", "minimum": 1 },
          "nextAction": { "$ref": "#/components/schemas/NextAction" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Artifact": {
        "type": "object",
        "required": ["url"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "maxLength": 2048, "description": "HTTPS URL stored without fetching." },
          "label": { "type": "string", "maxLength": 200 }
        }
      },
      "Event": {
        "type": "object",
        "required": ["id", "projectId", "sequence", "kind", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "projectId": { "type": "string" },
          "sequence": { "type": "integer", "minimum": 1 },
          "kind": {
            "type": "string",
            "enum": ["request", "reply", "artifact", "correction", "needs_human", "resolved", "reopened"]
          },
          "text": { "type": "string", "maxLength": 8000 },
          "artifact": { "$ref": "#/components/schemas/Artifact" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "security": [{ "BearerAuth": [] }],
  "paths": {
    "/healthz": {
      "get": {
        "security": [],
        "summary": "Service configuration and bounded store readiness",
        "responses": {
          "200": {
            "description": "Standalone service/store is ready, or shared mount reports disabled configuration with enabled=false",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "enabled": { "type": "boolean" },
                    "reason": { "type": "string" },
                    "store": { "type": "string", "enum": ["postgres", "memory"] }
                  }
                }
              }
            }
          },
          "503": { "description": "Store readiness failed; ok=false, enabled=false, reason=store_unavailable" }
        }
      }
    },
    "/v1/projects": {
      "post": {
        "summary": "Bootstrap a project (administrator only)",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "minLength": 8, "maxLength": 200 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "summary"],
                "properties": {
                  "title": { "type": "string", "maxLength": 120 },
                  "summary": { "type": "string", "maxLength": 2000 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["project", "ownerToken"],
                  "properties": {
                    "project": { "$ref": "#/components/schemas/Project" },
                    "ownerToken": { "type": "string" }
                  }
                }
              }
            }
          },
          "200": {
            "description": "Exact idempotent replay of the original create response, including the same ownerToken from the bounded replay record"
          },
          "400": { "description": "Invalid input", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Invalid administrator grant", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "Idempotency conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/v1/projects/{projectId}": {
      "get": {
        "summary": "Read a project with any active grant",
        "parameters": [
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Project",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["project"],
                  "properties": { "project": { "$ref": "#/components/schemas/Project" } }
                }
              }
            }
          },
          "401": { "description": "Invalid grant" },
          "404": { "description": "Missing or inaccessible project" }
        }
      }
    },
    "/v1/projects/{projectId}/grants": {
      "post": {
        "summary": "Issue a reader or writer grant (owner only)",
        "parameters": [
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["role"],
                "properties": {
                  "role": { "type": "string", "enum": ["reader", "writer"] },
                  "expiresAt": { "type": "string", "format": "date-time" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Grant issued once",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["grantId", "token", "role", "expiresAt"],
                  "properties": {
                    "grantId": { "type": "string" },
                    "token": { "type": "string" },
                    "role": { "type": "string", "enum": ["reader", "writer"] },
                    "expiresAt": { "type": ["string", "null"], "format": "date-time" }
                  }
                }
              }
            }
          },
          "403": { "description": "Insufficient scope" }
        }
      }
    },
    "/v1/projects/{projectId}/grants/{grantId}": {
      "delete": {
        "summary": "Revoke a grant (owner only); repeat revoke succeeds",
        "parameters": [
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "grantId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "204": { "description": "Revoked or already revoked" },
          "404": { "description": "Cross-project or missing grant" }
        }
      }
    },
    "/v1/projects/{projectId}/events": {
      "post": {
        "summary": "Append an event (owner or writer; resolved and reopened are owner only)",
        "parameters": [
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "minLength": 8, "maxLength": 200 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["request", "reply", "artifact", "correction", "needs_human", "resolved", "reopened"]
                  },
                  "text": { "type": "string", "maxLength": 8000 },
                  "artifact": { "$ref": "#/components/schemas/Artifact" },
                  "expectedVersion": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Required for resolved and reopened"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Event created", "content": { "application/json": { "schema": {
            "type": "object", "required": ["event", "project"], "properties": {
              "event": { "$ref": "#/components/schemas/Event" }, "project": { "$ref": "#/components/schemas/Project" }
            }
          } } } },
          "200": { "description": "Identical idempotent replay", "content": { "application/json": { "schema": {
            "type": "object", "required": ["event", "project"], "properties": {
              "event": { "$ref": "#/components/schemas/Event" }, "project": { "$ref": "#/components/schemas/Project" }
            }
          } } } },
          "409": { "description": "Idempotency or version conflict" }
        }
      },
      "get": {
        "summary": "List events after a project-scoped cursor",
        "parameters": [
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "maxLength": 256, "description": "Opaque cursor issued for this project. Keep the last nonempty page cursor to resume after an empty page." }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 }
          }
        ],
        "responses": {
          "200": {
            "description": "Stable ascending page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["events", "nextCursor"],
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Event" }
                    },
                    "nextCursor": { "type": ["string", "null"] }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid or foreign cursor" }
        }
      }
    }
  }
}
