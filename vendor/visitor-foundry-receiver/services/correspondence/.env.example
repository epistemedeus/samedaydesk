# Correspondence admin token. Issue once; store only where operators can rotate it.
CORRESPONDENCE_ADMIN_TOKEN=

# Postgres URL for production and local migrate/start.
DATABASE_URL=postgres://correspondence:correspondence@127.0.0.1:5432/correspondence

# Optional explicit store selector. memory is refused unless NODE_ENV=test.
# CORRESPONDENCE_STORE=postgres

PORT=8787

# Browser workbench origins allowed to call this service. Unset defaults to
# https://neomorphic.io only. Loopback is not implied. Set empty to allow none.
# CORRESPONDENCE_CORS_ORIGINS=https://neomorphic.io

# Reverse-proxy hop count for Express trust proxy. Default 0 (ignore
# X-Forwarded-*). Set to 1 only behind a known TLS terminator (e.g. Railway).
# Must be an integer 0–5; boolean true is rejected.
# CORRESPONDENCE_TRUST_PROXY=0

# Disposable DB for local accept:closed-pilot (never a shared production URL).
# CORRESPONDENCE_TEST_DATABASE_URL=postgres://correspondence:correspondence@127.0.0.1:5432/correspondence_test
