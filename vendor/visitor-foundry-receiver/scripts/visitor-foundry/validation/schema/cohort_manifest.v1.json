{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neomorphic.foundry.cohort_manifest.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "neomorphic.foundry.cohort_manifest.v1"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
    },
    "experimentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
    },
    "holdoutRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "taskClass": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
    },
    "metricVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
    },
    "capability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "environmentDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "purpose": {
      "enum": [
        "owner_qa",
        "sponsored_evaluation",
        "external_task",
        "unknown"
      ]
    },
    "relationship": {
      "enum": [
        "owner",
        "affiliated",
        "sponsored",
        "independent",
        "unknown"
      ]
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
          },
          "taskInputDigest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "taskInputDigest"
        ],
        "additionalProperties": false
      },
      "maxItems": 256
    },
    "arms": {
      "type": "array",
      "items": {
        "enum": [
          "baseline",
          "reuse_only",
          "contribution"
        ]
      },
      "maxItems": 3
    },
    "baselineSource": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "ref",
        "revision"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "scope",
    "experimentId",
    "holdoutRevision",
    "taskClass",
    "metricVersion",
    "capability",
    "environmentDigest",
    "purpose",
    "relationship",
    "cases",
    "arms",
    "baselineSource"
  ],
  "additionalProperties": false
}
