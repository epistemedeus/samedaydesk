{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neomorphic.foundry.verification_assignment.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "neomorphic.foundry.verification_assignment.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
    },
    "candidateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
    },
    "capability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "artifactDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "dependencyDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evaluator": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "environmentDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "requiredChecks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
      },
      "maxItems": 32
    },
    "runner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
    },
    "assignmentEvidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "mode": {
      "enum": [
        "fixture",
        "trusted_runner"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "assignedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$"
    },
    "deadline": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$"
    },
    "reservation": {
      "type": "object",
      "properties": {
        "cpuMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "wallMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "memoryMb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "cost": {
          "type": "object",
          "properties": {
            "currency": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "units": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,77})$"
            }
          },
          "required": [
            "currency",
            "units"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "cpuMs",
        "wallMs",
        "memoryMb",
        "cost"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "id",
    "candidateId",
    "capability",
    "sourceRevision",
    "artifactDigest",
    "dependencyDigest",
    "evaluator",
    "environmentDigest",
    "requiredChecks",
    "runner",
    "assignmentEvidence",
    "mode",
    "attempt",
    "assignedAt",
    "deadline",
    "reservation"
  ],
  "additionalProperties": false
}
