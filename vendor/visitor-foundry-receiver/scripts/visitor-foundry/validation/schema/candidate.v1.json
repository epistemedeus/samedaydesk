{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neomorphic.foundry.candidate.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "neomorphic.foundry.candidate.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
    },
    "capability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "artifactDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "artifactRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "id",
          "revision"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "rights": {
      "type": "object",
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "permissionRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "license",
        "permissionRef"
      ],
      "additionalProperties": false
    },
    "claimed": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "required": [
              "ref",
              "revision"
            ],
            "additionalProperties": false
          },
          "maxItems": 16
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 16
        }
      },
      "required": [
        "summary",
        "evidenceRefs",
        "limitations"
      ],
      "additionalProperties": false
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "id",
    "scope",
    "capability",
    "sourceRevision",
    "artifactDigest",
    "artifactRef",
    "taskId",
    "dependencies",
    "rights",
    "claimed",
    "supersedes"
  ],
  "additionalProperties": false
}
