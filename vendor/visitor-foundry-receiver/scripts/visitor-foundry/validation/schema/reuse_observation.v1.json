{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neomorphic.foundry.reuse_observation.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "neomorphic.foundry.reuse_observation.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
    },
    "candidateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
    },
    "capability": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
    },
    "environmentDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "taskInputDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$"
    },
    "relationship": {
      "enum": [
        "owner",
        "affiliated",
        "sponsored",
        "independent",
        "unknown"
      ]
    },
    "purpose": {
      "enum": [
        "owner_qa",
        "sponsored_evaluation",
        "external_task",
        "unknown"
      ]
    },
    "outcome": {
      "enum": [
        "useful",
        "not_useful",
        "failed",
        "unknown"
      ]
    },
    "outcomeSource": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "ref",
        "revision"
      ],
      "additionalProperties": false
    },
    "adaptation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "effortMs": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "cost": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "currency": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "units": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,77})$"
            }
          },
          "required": [
            "currency",
            "units"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "cohort": {
      "type": "object",
      "properties": {
        "experimentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
        },
        "holdoutRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "taskClass": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
        },
        "metricVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
        },
        "arm": {
          "enum": [
            "baseline",
            "reuse_only",
            "contribution"
          ]
        },
        "caseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
        }
      },
      "required": [
        "experimentId",
        "holdoutRevision",
        "taskClass",
        "metricVersion",
        "arm",
        "caseId"
      ],
      "additionalProperties": false
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*:[a-zA-Z0-9._:/@+-]+$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "id",
    "scope",
    "candidateId",
    "capability",
    "taskId",
    "environmentDigest",
    "taskInputDigest",
    "occurredAt",
    "relationship",
    "purpose",
    "outcome",
    "outcomeSource",
    "adaptation",
    "effortMs",
    "cost",
    "cohort",
    "supersedes"
  ],
  "additionalProperties": false
}
