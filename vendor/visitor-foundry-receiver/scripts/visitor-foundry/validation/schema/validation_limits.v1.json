{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "neomorphic.foundry.validation_limits.v1",
  "type": "object",
  "properties": {
    "maxOutstanding": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "maxPerScope": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "maxRunning": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "maxRunningPerScope": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "maxRecords": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "maxCommands": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "maxCpuMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxWallMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxMemoryMb": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "maxCost": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "units": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$"
        }
      },
      "required": [
        "currency",
        "units"
      ],
      "additionalProperties": false
    },
    "maxReviewMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxReviews": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "maxOutstanding",
    "maxPerScope",
    "maxRunning",
    "maxRunningPerScope",
    "maxRecords",
    "maxCommands",
    "maxCpuMs",
    "maxWallMs",
    "maxMemoryMb",
    "maxCost",
    "maxReviewMs",
    "maxReviews"
  ],
  "additionalProperties": false
}
