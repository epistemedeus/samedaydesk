{
  "openapi": "3.1.0",
  "info": {
    "title": "Neomorphic earned-work API",
    "version": "0.1.0",
    "description": "S275 prototype kernel for a contributor-first agent-effort marketplace. Stores tasks, reservations, artifact metadata, verdicts, and typed owed obligations. It does not execute artifacts, fetch artifact refs, implement payment rails, or settle transfers. Fixture/test provenance is explicit. Reward 0.10 USDC is a disclosed hypothesis."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8791",
      "description": "Local fixture process. Not a hosted exchange."
    }
  ],
  "components": {
    "securitySchemes": {
      "OwnerBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "Owner token from EARNED_WORK_OWNER_TOKEN. Only SHA-256 hashes are compared; plaintext is not stored in Postgres."
      },
      "ContributorBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "Scoped contributor token issued by POST /v1/contributor-tokens. Hashes stored at rest."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      },
      "Reward": {
        "type": "object",
        "required": ["amount", "asset", "network"],
        "additionalProperties": false,
        "properties": {
          "amount": { "type": "string", "description": "Atomic decimal string. Never a float." },
          "asset": { "type": "string" },
          "network": { "type": "string" }
        }
      },
      "Artifact": {
        "type": "object",
        "required": ["ref", "digestSha256", "mediaType", "bytes"],
        "additionalProperties": false,
        "properties": {
          "ref": { "type": "string", "maxLength": 2048, "description": "Metadata only. Never fetched or executed." },
          "digestSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "mediaType": { "type": "string" },
          "bytes": { "type": "integer", "minimum": 1 }
        }
      },
      "Provenance": {
        "type": "string",
        "enum": ["test", "fixture", "production"]
      },
      "Obligation": {
        "type": "object",
        "required": ["kind", "adapter", "payoutState", "transfer", "reward"],
        "properties": {
          "kind": { "type": "string", "const": "owed_record" },
          "adapter": { "type": "string", "const": "typed_owed_record_v0" },
          "payoutState": { "type": "string", "const": "owed" },
          "transfer": { "type": "null", "description": "Always null. No payment rail." },
          "reward": { "$ref": "#/components/schemas/Reward" }
        }
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 8, "maxLength": 200 }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "security": [],
        "summary": "Store readiness",
        "responses": {
          "200": { "description": "Store is reachable" },
          "503": { "description": "Store unavailable" }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "security": [],
        "summary": "OpenAPI 3 document",
        "responses": {
          "200": { "description": "OpenAPI document" }
        }
      }
    },
    "/v1/tasks": {
      "get": {
        "security": [],
        "summary": "List open tasks (public redacted)",
        "responses": {
          "200": { "description": "Redacted open tasks. No tokens, payout destinations, or budget internals." }
        }
      },
      "post": {
        "security": [{ "OwnerBearer": [] }],
        "summary": "Create task + terms + funding declaration",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "summary", "provenance", "reward", "budget"],
                "properties": {
                  "title": { "type": "string" },
                  "summary": { "type": "string" },
                  "provenance": { "$ref": "#/components/schemas/Provenance" },
                  "reward": { "$ref": "#/components/schemas/Reward" },
                  "budget": { "$ref": "#/components/schemas/Reward" },
                  "correctionPolicy": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "maxRevisions": { "type": "integer", "minimum": 0, "maximum": 1, "description": "Bounded correction policy. Default 1." }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created" },
          "200": { "description": "Idempotent replay" }
        }
      }
    },
    "/v1/tasks/{taskId}": {
      "get": {
        "summary": "Task status — public redacted, or owner view with owner bearer",
        "parameters": [
          { "name": "taskId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Task status" },
          "404": { "description": "Not found" }
        }
      }
    },
    "/v1/tasks/{taskId}/terms": {
      "post": {
        "security": [{ "OwnerBearer": [] }],
        "summary": "New immutable termsVersion",
        "parameters": [
          { "name": "taskId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "201": { "description": "New termsVersion" },
          "409": { "description": "Occupying reservation or already accepted" }
        }
      }
    },
    "/v1/tasks/{taskId}/funding/reserve": {
      "post": {
        "security": [{ "OwnerBearer": [] }],
        "summary": "unfunded→reserved when budget covers reward",
        "parameters": [
          { "name": "taskId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": { "description": "Funding reserved" },
          "409": { "description": "Oversubscribed or already released" }
        }
      }
    },
    "/v1/contributor-tokens": {
      "post": {
        "security": [{ "OwnerBearer": [] }],
        "summary": "Test helper: issue a scoped contributor bearer. Token plaintext returned once; hash stored.",
        "responses": {
          "201": { "description": "Token issued" }
        }
      }
    },
    "/v1/tasks/{taskId}/claims": {
      "post": {
        "security": [{ "ContributorBearer": [] }],
        "summary": "Atomic claim. Rejects reserved-elsewhere, expired, and oversubscribed.",
        "parameters": [
          { "name": "taskId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "201": { "description": "Reservation created" },
          "409": { "description": "reserved_elsewhere, unfunded, oversubscribed, or terms_changed" }
        }
      }
    },
    "/v1/tasks/{taskId}/submissions": {
      "post": {
        "security": [{ "ContributorBearer": [] }],
        "summary": "Bound artifact metadata. Never executed. Rejects late/duplicate/oversize/malformed.",
        "parameters": [
          { "name": "taskId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["reservationId", "artifact"],
                "properties": {
                  "reservationId": { "type": "string" },
                  "artifact": { "$ref": "#/components/schemas/Artifact" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Submission recorded" },
          "409": { "description": "late_submission, duplicate_submission, or terms_changed" }
        }
      }
    },
    "/v1/tasks/{taskId}/verdicts": {
      "post": {
        "security": [{ "OwnerBearer": [] }],
        "summary": "pass/fail/needs_review. Omit outcome to run the deterministic verifier hook (digest/media/bytes bounds; no execution).",
        "parameters": [
          { "name": "taskId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "201": { "description": "Verdict recorded" }
        }
      }
    },
    "/v1/tasks/{taskId}/accept": {
      "post": {
        "security": [{ "OwnerBearer": [] }],
        "summary": "Acceptance → payoutState=owed + typed obligation. No transfer.",
        "parameters": [
          { "name": "taskId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "201": { "description": "Obligation owed" }
        }
      }
    },
    "/v1/tasks/{taskId}/reject": {
      "post": {
        "security": [{ "OwnerBearer": [] }],
        "summary": "Rejection / correction. New termsVersion path via POST /terms.",
        "parameters": [
          { "name": "taskId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": { "description": "Rejected" }
        }
      }
    },
    "/v1/tasks/{taskId}/obligation": {
      "get": {
        "security": [{ "OwnerBearer": [] }],
        "summary": "Typed owed obligation (no transfer)",
        "parameters": [
          { "name": "taskId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Owed record",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "obligation": { "$ref": "#/components/schemas/Obligation" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/tasks/{taskId}/payout": {
      "get": {
        "security": [{ "OwnerBearer": [] }],
        "summary": "Payout reconciliation. Default adapter is null/nonpaying. owed is not paid and not settled.",
        "parameters": [
          { "name": "taskId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Reconciliation. transfer is always null. paid and settled are always false."
          },
          "401": { "description": "Owner bearer required" }
        }
      }
    }
  }
}
