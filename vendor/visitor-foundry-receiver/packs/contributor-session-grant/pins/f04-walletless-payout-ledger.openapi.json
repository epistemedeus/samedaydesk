{
  "openapi": "3.1.0",
  "info": {
    "title": "Neomorphic walletless payout ledger API",
    "version": "0.1.0",
    "description": "F04 obligation ledger: late-address claim, budget encumbrance, and truthful owed vs paid status. Stores typed IOUs. The null/nonpaying fixture rail never confirms payout. Signer keys stay outside this service. An owed row is not settled money. Fixture/test provenance is explicit. Reward 0.10 USDC is a disclosed hypothesis."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8794",
      "description": "Local fixture process. Not a hosted exchange. Local tokens only."
    }
  ],
  "components": {
    "securitySchemes": {
      "AdminBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "WALLETLESS_LEDGER_ADMIN_TOKEN. Hashes stored at rest. Local tokens only."
      },
      "GrantBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "Owner, writer, observer, or contributor grant. Observer/writer cannot authorize payout."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        }
      },
      "Reward": {
        "type": "object",
        "required": ["amount", "asset", "network"],
        "additionalProperties": false,
        "properties": {
          "amount": { "type": "string", "description": "Atomic decimal string. Never a float." },
          "asset": { "type": "string" },
          "network": { "type": "string" }
        }
      },
      "PayoutState": {
        "type": "string",
        "enum": ["none", "owed", "queued", "submitted", "confirmed", "failed", "unknown"]
      },
      "FundingState": {
        "type": "string",
        "enum": ["unfunded", "reserved", "released"]
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "minLength": 8, "maxLength": 200 }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "security": [],
        "summary": "Store readiness",
        "responses": {
          "200": { "description": "Store is reachable" },
          "503": { "description": "Store unavailable" }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "security": [],
        "summary": "OpenAPI 3 document",
        "responses": { "200": { "description": "OpenAPI document" } }
      }
    },
    "/v1/grants": {
      "post": {
        "security": [{ "AdminBearer": [] }],
        "summary": "Issue a local grant. Observer/writer cannot authorize payout.",
        "responses": { "201": { "description": "Token issued once; hash stored." } }
      }
    },
    "/v1/envelopes": {
      "post": {
        "security": [{ "AdminBearer": [] }, { "GrantBearer": [] }],
        "summary": "Create a budget envelope (C08).",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": { "201": { "description": "Created" }, "409": { "description": "Overcommit or conflict" } }
      }
    },
    "/v1/envelopes/{envelopeId}": {
      "get": {
        "security": [{ "GrantBearer": [] }],
        "summary": "Envelope record",
        "responses": { "200": { "description": "Envelope" } }
      }
    },
    "/v1/envelopes/{envelopeId}/projection": {
      "get": {
        "security": [{ "GrantBearer": [] }],
        "summary": "spent + reserved + payable + labelled gas vs cap",
        "responses": { "200": { "description": "Projection" } }
      }
    },
    "/v1/obligations": {
      "post": {
        "security": [{ "AdminBearer": [] }, { "GrantBearer": [] }],
        "summary": "Create a durable owed obligation from an S275 acceptance fixture (C01). Status is owed, never paid.",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": {
          "201": { "description": "Owed obligation" },
          "409": { "description": "Duplicate award or budget overcommit" }
        }
      }
    },
    "/v1/obligations/{obligationId}": {
      "get": {
        "security": [{ "GrantBearer": [] }],
        "summary": "Authenticated obligation. paid=false and settled=false until a paying rail confirms (this service has none).",
        "responses": { "200": { "description": "Obligation" } }
      }
    },
    "/v1/public/obligations/{obligationId}": {
      "get": {
        "security": [],
        "summary": "Public JSON. Label is owed, not paid. Destination and transfer key redacted.",
        "responses": { "200": { "description": "Redacted IOU" } }
      }
    },
    "/v1/public/obligations/{obligationId}/view": {
      "get": {
        "security": [],
        "summary": "Public HTML. Must render owed, not paid. Must not render an IOU as settled money.",
        "responses": { "200": { "description": "HTML" } }
      }
    },
    "/v1/obligations/{obligationId}/destination": {
      "post": {
        "security": [{ "GrantBearer": [] }],
        "summary": "Late payout address claim (C02). Status remains owed until reconcile. Allowlisted asset/network only.",
        "responses": {
          "200": { "description": "Still owed" },
          "400": { "description": "Unsupported network or malformed destination" }
        }
      }
    },
    "/v1/obligations/{obligationId}/queue": {
      "post": {
        "security": [{ "GrantBearer": [] }],
        "summary": "Durable payout intent (C01). Owner only. Observer/writer forbidden.",
        "responses": { "200": { "description": "Queued, not paid" }, "403": { "description": "Observer/writer cannot authorize payout" } }
      }
    },
    "/v1/obligations/{obligationId}/reconcile": {
      "post": {
        "security": [{ "GrantBearer": [] }],
        "summary": "Nonpaying reconcile. Records submitted/failed/unknown honestly. Never confirmed from the fake rail. Same idempotency key after unknown.",
        "responses": {
          "200": { "description": "Typed rail result; paid=false" },
          "400": { "description": "confirm_forbidden" },
          "409": { "description": "fresh_transfer_forbidden" }
        }
      }
    }
  }
}
