# S275 earned-work local/docker fixture. Not production secrets.
# provenance: fixture | test — never treat a passing local journey as hosted settlement.

# Fixture Postgres (docker-compose maps 55432, or local initdb, or any TCP Postgres you control).
EARNED_WORK_DATABASE_URL=postgres://earned_work:earned_work@127.0.0.1:55432/earned_work_test

# Owner bearer for local fixture. Compared via SHA-256 hash; plaintext is not stored in Postgres.
EARNED_WORK_OWNER_TOKEN=dev-owner-token-s275

# HTTP
PORT=8791

# Optional
# EARNED_WORK_PG_SCHEMA=public
# EARNED_WORK_POOL_MAX=4
# EARNED_WORK_CORS_ORIGINS=https://neomorphic.io
# EARNED_WORK_TRUST_PROXY=0
# EARNED_WORK_RATE_LIMIT_WINDOW_MS=60000
# EARNED_WORK_RATE_LIMIT_MAX=120
