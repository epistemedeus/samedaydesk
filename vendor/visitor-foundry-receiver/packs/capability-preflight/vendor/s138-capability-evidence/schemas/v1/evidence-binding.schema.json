{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s138.evidence-binding.v1",
  "title": "Capability evidence binding",
  "type": "object",
  "required": ["schema", "capabilityId", "status", "executionVerified", "bindings", "gaps", "claimed", "observed", "verified"],
  "properties": {
    "schema": { "const": "s138.evidence-binding.v1" },
    "capabilityId": { "const": "R2-CAPABILITIES-03" },
    "status": { "enum": ["content_bound", "untested_declaration"] },
    "executionVerified": { "const": false },
    "provenanceSufficientAlone": { "const": false },
    "claimed": {
      "type": "object",
      "description": "Caller-asserted identity and imported parsed TAP facts. Not proof of execution."
    },
    "observed": {
      "type": "object",
      "description": "Library observations of supplied bytes/exitCode. Not a live run attestation."
    },
    "verified": {
      "type": "object",
      "description": "Cross-checks only (digest matches content, revision alignment, pass consistency)."
    },
    "bindings": { "type": "array" },
    "gaps": { "type": "array" }
  }
}
