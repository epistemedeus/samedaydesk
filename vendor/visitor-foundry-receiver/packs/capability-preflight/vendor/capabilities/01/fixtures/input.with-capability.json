{
  "requirements": {
    "schema": "pilot.r2.capabilities.task_requirements.v1",
    "taskId": "demo-cap-bound-note",
    "title": "Capability-bound observation note",
    "summary": "Same Exchange requirements shape via capabilities alias, plus a synthetic capabilityContract.",
    "demo": true,
    "sourceLabel": "synthetic-capability",
    "artifact": {
      "format": "json",
      "maxBytes": 4096,
      "requiredFields": ["sourceUrl", "summary"]
    },
    "objectiveCriteria": [
      {
        "id": "source_https",
        "description": "sourceUrl must be https",
        "check": { "kind": "https_url_shape", "path": "sourceUrl" }
      },
      {
        "id": "summary_bound",
        "description": "summary length bound",
        "check": { "kind": "string_max_length", "path": "summary", "max": 300 }
      }
    ],
    "subjectiveCriteria": [
      {
        "id": "operator_keep",
        "description": "Operator keep/discard",
        "reviewHint": "Unresolved until human review."
      }
    ]
  },
  "capabilityContract": {
    "id": "public-docs-observe.v1",
    "path": "experiments/commons-20260909/task-memory-contract",
    "inputs": [
      {
        "id": "source_uri",
        "name": "Public source URI",
        "kind": "https_url",
        "required": true,
        "notes": "Caller-supplied public docs locator"
      },
      {
        "id": "label",
        "name": "Observation label",
        "kind": "string",
        "required": false
      }
    ],
    "outputs": [
      { "id": "observation_json", "name": "Observation JSON", "kind": "artifact" }
    ],
    "evidenceHints": [
      "sha256 digest of retrieved public bytes is acceptable objective evidence",
      { "id": "url_shape", "kind": "binding", "checkKind": "https_url_shape", "note": "Capability binds https_url_shape evidence" }
    ]
  },
  "providedInputs": {
    "source_uri": "https://example.com/docs/changelog"
  }
}
