{
  "name": "@neomorphic/funded-task-terms",
  "version": "0.1.0",
  "private": true,
  "description": "Typed funded-task terms schema and validator for F01/F04. No payment, deployment, or artifact execution.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./hash": {
      "types": "./src/hash.d.ts",
      "import": "./src/hash.mjs",
      "default": "./src/hash.mjs"
    },
    "./schema/funded-task-terms.v1.json": "./schema/funded-task-terms.v1.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "funded-task-terms": "./bin/validate.mjs"
  },
  "scripts": {
    "validate": "node --import tsx ./bin/validate.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.17.2",
    "ajv": "8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  },
  "license": "MIT"
}
