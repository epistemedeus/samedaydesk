# Existing SameDayDesk Node application; retain its current start command.
# Replace absolute paths with the SAME existing durable directory on each deploy.
NODE_ENV=production
MACHINE_GATEWAY_ENABLED=1
MACHINE_GATEWAY_PAYMENTS_ENABLED=0
MACHINE_GATEWAY_STATE_FILE=/absolute/existing/private/machine-gateway/machine-gateway.sqlite
MACHINE_GATEWAY_TENANTS_FILE=/absolute/existing/private/machine-gateway/tenants.json

# Standalone local/operator process only. Shared mount does not open a listener.
MACHINE_GATEWAY_LISTEN_HOST=127.0.0.1
# PORT=8787
