{
  "openapi": "3.1.0",
  "info": {
    "title": "Neomorphic Machine gateway",
    "version": "0.1.0",
    "description": "Mounted service contract. Prepared for deployment; this document is not evidence of a live endpoint."
  },
  "x-release-state": "prepared-not-deployed",
  "servers": [
    {
      "url": "/api/machine-gateway"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "gatewayHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Validated response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/health"
                }
              }
            }
          },
          "default": {
            "description": "Bounded JSON error; no provider text or credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/discover": {
      "get": {
        "operationId": "discoverRoutes",
        "security": [],
        "responses": {
          "200": {
            "description": "Validated response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/discovery"
                }
              }
            }
          },
          "default": {
            "description": "Bounded JSON error; no provider text or credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/quote": {
      "post": {
        "operationId": "quoteRoute",
        "security": [
          {},
          {
            "tenantBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/quoteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/quote"
                }
              }
            }
          },
          "default": {
            "description": "Bounded JSON error; no provider text or credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        },
        "description": "Free. Anonymous quotes are previews; authenticated quotes bind one tenant, route, price and exact input for 60 seconds."
      }
    },
    "/v1/test": {
      "post": {
        "operationId": "testRouteFixture",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/testRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validated response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/test"
                }
              }
            }
          },
          "default": {
            "description": "Bounded JSON error; no provider text or credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        },
        "description": "Free deterministic test fixture. Does not execute caller input or enter payment adapters."
      }
    },
    "/v1/execute": {
      "post": {
        "operationId": "executeBoundQuote",
        "security": [
          {
            "tenantBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/executeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Persisted completed, failed or uncertain receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/receipt"
                }
              }
            }
          },
          "202": {
            "description": "Same admitted attempt is still running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/receipt"
                }
              }
            }
          },
          "default": {
            "description": "Validated response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{16,128}$"
            }
          },
          {
            "in": "header",
            "name": "Payment-Signature",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 16384
            },
            "description": "Only for a deployment-enabled paid route using its existing facilitator adapter. Free routes reject this header."
          }
        ],
        "description": "One execution per quote and one possible settlement per authorization. Retry identical bytes/fields and the same idempotency key; unresolved attempts never restart."
      }
    },
    "/v1/receipts/{id}": {
      "get": {
        "operationId": "readPersistedReceipt",
        "security": [
          {
            "tenantBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Validated response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/receipt"
                }
              }
            }
          },
          "default": {
            "description": "Bounded JSON error; no provider text or credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9-]{36}$"
            }
          }
        ],
        "description": "Tenant-bound persisted readback. Another tenant receives 404. Expired in-flight work becomes uncertain without resending."
      }
    },
    "/v1/routes/lockfile.delta/input.schema.json": {
      "get": {
        "operationId": "lockfile_delta_input_schema",
