# Names only. Keep the existing Hostinger environment in full.
# Required: the already enrolled correspondence database binding.
CORRESPONDENCE_DATABASE_URL
# Existing CA path, when configured; retained unchanged.
CORRESPONDENCE_PGSSL_CA_FILE

# Optional TLS-specific URL for the SAME database/host/port/user as correspondence.
# It must use sslmode=verify-full. This avoids editing the old service's URL.
MACHINE_SERVICES_DATABASE_URL
MACHINE_SERVICES_PGSSL_CA_FILE
MACHINE_SERVICES_PGSSL_CA_PEM
# Private configuration can be regenerated under an existing writable /tmp parent.
# Durable state never uses this directory. Choose a dedicated directory outside the checkout/public_html.
MACHINE_SERVICES_PRIVATE_DIR

# Gateway (enable=1; payments=0; store=postgres).
MACHINE_GATEWAY_ENABLED
MACHINE_GATEWAY_PAYMENTS_ENABLED
MACHINE_GATEWAY_STORE
# One of private file or JSON, following vendor/machine-gateway schemas/tenantConfig.
MACHINE_GATEWAY_TENANTS_FILE
MACHINE_GATEWAY_TENANTS_JSON
# Optional url.extract binding, private file or JSON: {"schema":"ae19_paid_continuation","tenantId":"...","actorId":"..."}.
# Absent = url.extract.* fail closed url_extract_unbound. Named but absent file = url_extract_binding_missing.
# The extraction schema is provisioned by machine-services:migrate; serving never migrates.
MACHINE_GATEWAY_URL_EXTRACT_FILE
MACHINE_GATEWAY_URL_EXTRACT_JSON

# Monitor (enable=1; scheduler=1; store=postgres).
MONITOR_ENABLED
MONITOR_SCHEDULER
MONITOR_STORE
# Optional {"options":{"maxTick":1,"maxMonitors":200}}. The N2 continuous-monitoring
# deploy/runtime.example.json is accepted as-is: database -> enrolled PG pilot_monitor,
# host/port -> SDS listener /api/monitor; those three are type-checked and ignored.
MONITOR_RUNTIME_FILE
MONITOR_RUNTIME_JSON
# Provisioning command only. Not required or read by the listener.
MONITOR_GRANT_FILE
MONITOR_GRANT_JSON

# Host mode (production on Hostinger; test/development only enable the SQLite adapters).
NODE_ENV

# Optional discovery log. Absent DIR leaves the log unmounted.
# When FOUNDRY_PRIVATE_DIR is already in the baseline, DISCOVERY_LOG_DIR must be that
# directory plus discovery-log-v1. The baseline value is not overwritten. The enrolled
# host value of FOUNDRY_PRIVATE_DIR is /home/u188979531/pilot-retained-host-v1, so the
# log directory is /home/u188979531/pilot-retained-host-v1/discovery-log-v1.
# prepare-host.mjs checks mode 0700 and file mode 0600. app.js remains the only writer.
# export-log.mjs reads one discovery-YYYY-MM-DD.ndjson. retain.mjs deletes aged daily
# files only when --retain-days is passed. Proposal: 30. The number is not chosen here.
DISCOVERY_LOG_DIR
DISCOVERY_LOG_QA_SECRET
DISCOVERY_LOG_JOURNEY_SECRET
