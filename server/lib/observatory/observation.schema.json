{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "External observatory returned envelopes, snapshots and source catalog",
  "oneOf": [
    {
      "$ref": "#/definitions/observation"
    },
    {
      "$ref": "#/definitions/snapshot"
    },
    {
      "$ref": "#/definitions/catalog"
    }
  ],
  "definitions": {
    "metric": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "ok",
            "missing",
            "invalid",
            "unavailable",
            "error",
            "nonfinite",
            "negative",
            "overflow",
            "schema_drift",
            "contradictory",
            "source_error"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "unitClass": {
          "enum": [
            "count",
            "money",
            "ratio",
            "atomic",
            "custom",
            "absent",
            "invalid"
          ]
        },
        "definition": {
          "type": [
            "string",
            "null"
          ]
        },
        "population": {
          "type": [
            "string",
            "null"
          ]
        },
        "window": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceClass": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "key",
        "value",
        "state",
        "unit",
        "definition",
        "population",
        "window"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": [
                  "number",
                  "string"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "pilot.external-observatory.v1"
        },
        "fetchedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceId": {
          "enum": [
            "moltjobs",
            "x402stats",
            "smithery_mcp",
            "moltjobs_open_jobs"
          ]
        },
        "sourceKind": {
          "enum": [
            "work_market",
            "settlement",
            "capability_discovery"
          ]
        },
        "upstreamUrl": {
          "type": "string"
        },
        "providerTimestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "providerTimestampState": {
          "enum": [
            "ok",
            "missing",
            "stale",
            "invalid"
          ]
        },
        "availability": {
          "enum": [
            "ok",
            "partial",
            "unavailable",
            "stale",
            "error"
          ]
        },
        "httpStatus": {
          "type": [
            "integer",
            "null"
          ]
        },
        "cache": {
          "type": "object",
          "properties": {
            "hit": {
              "type": "boolean"
            },
            "ageMs": {
              "type": [
                "number",
                "null"
              ]
            },
            "stale": {
              "type": "boolean"
            },
            "ttlMs": {
              "type": [
                "number",
                "null"
              ]
            },
            "fetchedAt": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "hit",
            "ageMs",
            "stale",
            "ttlMs",
            "fetchedAt"
          ],
          "additionalProperties": true
        },
        "metrics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/metric"
          }
        },
        "coverage": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            },
            "complete": {
              "const": false
            },
            "additivity": {
              "const": "not_additive"
            },
            "population": {
              "type": [
                "string",
                "null"
              ]
            },
            "window": {
              "type": [
                "string",
                "null"
              ]
            },
            "notes": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "complete",
            "additivity",
            "population",
            "window",
            "notes"
          ],
          "additionalProperties": true
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "evidenceClass": {
          "type": [
            "string",
            "null"
          ]
        },
        "rawSourceLink": {
          "type": [
            "string",
            "null"
          ]
        },
        "withheldConclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourceLifecycle": {
          "type": "object",
          "properties": {
            "sourceId": {
              "type": "string"
            },
            "kind": {
              "const": "provider_declared_retirement"
            },
            "announcement": {
              "type": "object",
              "properties": {
                "precision": {
                  "const": "date"
                },
                "date": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "time": {
                  "type": "null"
                },
                "timeZone": {
                  "type": "null"
                },
                "officialInstant": {
                  "type": "null"
                },
                "sourceUrl": {
                  "type": "string"
                }
              },
              "required": ["precision", "date", "time", "timeZone", "officialInstant", "sourceUrl"],
              "additionalProperties": false
            },
            "collectionPolicy": {
              "type": "object",
              "properties": {
                "role": {
                  "const": "sds_collection_policy"
                },
                "timeBasis": {
                  "const": "utc_start_of_announced_calendar_date"
                },
                "admitBefore": {
                  "type": "string"
                },
                "officialShutdown": {
                  "type": "null"
                },
                "measuredShutdown": {
                  "type": "null"
                },
                "note": {
                  "type": "string"
                }
              },
              "required": ["role", "timeBasis", "admitBefore", "officialShutdown", "measuredShutdown", "note"],
              "additionalProperties": false
            },
            "capturePlacement": {
              "enum": ["before_collection_policy", "at_or_after_collection_policy", "unplaced"]
            },
            "currentAdmission": {
              "enum": ["open", "closed", "not_evaluated"]
            },
            "policyAdmitsCapture": {
              "type": "boolean"
            },
            "observedFailure": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "availability": {
                      "enum": ["unavailable", "error"]
                    }
                  },
                  "required": ["code", "availability"],
                  "additionalProperties": false
                }
              ]
            },
            "announcementIsOutage": {
              "const": false
            },
            "measuredShutdown": {
              "type": "null"
            },
            "doesNotEstablish": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "sourceId",
            "kind",
            "announcement",
            "collectionPolicy",
            "capturePlacement",
            "currentAdmission",
            "policyAdmitsCapture",
            "observedFailure",
            "announcementIsOutage",
            "measuredShutdown",
            "doesNotEstablish"
          ],
          "additionalProperties": false
        },
        "rawExcerpt": {
          "type": "string"
        },
        "paidActivity": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "fetchedAt",
        "sourceId",
        "sourceKind",
        "upstreamUrl",
        "providerTimestamp",
        "providerTimestampState",
        "availability",
        "httpStatus",
        "cache",
        "metrics",
        "coverage",
        "errors",
        "warnings",
        "evidenceClass",
        "rawSourceLink",
        "withheldConclusions"
      ],
      "additionalProperties": true
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "pilot.external-observatory.v1"
        },
        "fetchedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "additivity": {
          "const": "not_additive"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/observation"
          }
        },
        "documentedUnavailable": {
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "fetchedAt",
        "additivity",
        "observations",
        "documentedUnavailable"
      ],
      "additionalProperties": true
    },
    "catalog": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "pilot.external-observatory.v1"
        },
        "additivity": {
          "const": "not_additive"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string"
              },
              "sourceKind": {
                "type": "string"
              },
              "upstreamUrl": {
                "type": "string"
              },
              "metricKeys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "sourceId",
              "sourceKind",
              "upstreamUrl",
              "metricKeys"
            ],
            "additionalProperties": true
          }
        },
        "documentedUnavailable": {
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "additivity",
        "sources",
        "documentedUnavailable"
      ],
      "additionalProperties": true
    }
  }
}
